{
  "name": "@shipit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:acceptance": "tsx --test test/acceptance/*.test.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@shipit/database": "*",
    "@shipit/shared-types": "*",
    "@shipit/validation": "*",
    "bullmq": "^6.3.11",
    "bwip-js": "^4.11.4",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
