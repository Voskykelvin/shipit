{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Ship It: Backend Build",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "Ship It: Generate Prisma Client",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"db:generate",
				"--workspace=@shipit/database"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Ship It: Backend Tests",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
	]
}